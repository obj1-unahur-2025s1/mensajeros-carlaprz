import mensajeros.*
import destinos.*
import transportes.*
import paquetes.*

describe "Mensajeros De Pelicula | test" {
  test "Que roberto (90kg) puede llevar un paquete que está pago en un camión que tiene un acoplado." {
    assert.equals(90, roberto.peso())
    roberto.cambiarTransporte(camion)
    paquete.pagarEnvio()
    assert.equals(true, paquete.puedeSerEntregado(roberto))
  }
  
  test "Que neo con crédito no puede llevar un paquete que no está pago a la matrix." {
    neo.recargarCredito()
    assert.equals(true, neo.puedeLlamar())
    paquete.cambiarDestino(matrix)
    assert.equals(false, paquete.puedeSerEntregado(paquete))
  }
}

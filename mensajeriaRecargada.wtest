import mensajerosDePelicula.*
import empresas.*
import mensajeriaRecargada.*

describe "Mensajeria Recargada | test" {
  test "un paquete puede ser entregado por la empresa de mensajería, es decir, si al menos uno de sus mensajeros puede entregar el paquete." {
    camion.cantidadDeAcoplados(1)
    roberto.transporte(camion)
    paquete.pagarEnvio()
    assert.equals(false, paquete.puedeSerEntregado(roberto, puenteBrooklyn))
    empresaDeMensajeria.contratarMensajero(roberto)
    empresaDeMensajeria.contratarMensajero(chuckNorris)
    assert.equals(true, paquete.puedeSerEntregado(chuckNorris, puenteBrooklyn))
    assert.equals(
      true,
      empresaDeMensajeria.algunoPuedeEntregar(paquete, puenteBrooklyn)
    )
  }
}
